---
import AppLayout from '../layouts/AppLayout.astro';import ProgressDashboard from '../components/progress/ProgressDashboard';import DataManager from '../components/DataManager';
---
<AppLayout title="Progress & local data"><section class="page-width page-intro"><h1 class="display-title">Evidence, not a fake grade.</h1><p class="page-context">Local only · no account required</p><p class="lede">See what has evidence, what needs another pass, and what stays local.</p><details class="route-note"><summary>How evidence is counted</summary><p>Secure requires repeated evidence, including independent success. Hints and reveals remain visible instead of counting as unaided work.</p></details></section><section class="page-width section-shell"><ProgressDashboard client:load /></section><section class="page-width section-shell" aria-labelledby="data-heading"><div class="section-heading"><div><h2 id="data-heading">Your study data</h2><p class="section-context">Private &amp; portable</p></div></div><DataManager client:load /></section></AppLayout>
