---
import AppLayout from '../layouts/AppLayout.astro';import ProgressDashboard from '../components/progress/ProgressDashboard';import DataManager from '../components/DataManager';
---
<AppLayout title="Progress & local data"><section class="page-width page-intro"><h1 class="display-title">Evidence, not a fake grade.</h1><p class="page-context">Local only · no account required</p><p class="lede">A skill becomes Secure only after repeated evidence, including independent success. Hints and reveals remain visible in the record rather than being treated as identical to unaided work.</p></section><section class="page-width section-shell"><ProgressDashboard client:load /></section><section class="page-width section-shell" aria-labelledby="data-heading"><div class="section-heading"><div><h2 id="data-heading">Local data controls</h2><p class="section-context">Portability & privacy</p></div></div><DataManager client:load /></section></AppLayout>
