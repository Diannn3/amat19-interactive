---
import AppLayout from '../layouts/AppLayout.astro';import ProgressDashboard from '../components/progress/ProgressDashboard';import DataManager from '../components/DataManager';
---
<AppLayout title="Progress & local data">
  <section class="page-width page-intro progress-intro">
    <h1 class="display-title">Your learning progress</h1>
    <p class="lede">See the skills you’ve practiced, what needs review, and your saved study history.</p>
    <p class="page-context">Saved on this device. No account required.</p>
    <details class="route-note"><summary>How progress is measured</summary><p>Secure requires repeated evidence, including independent success. Hints and reveals remain visible instead of counting as unaided work.</p></details>
  </section>
  <section class="page-width section-shell"><ProgressDashboard client:load /></section>
  <section class="page-width section-shell" aria-labelledby="data-heading"><div class="section-heading"><div><h2 id="data-heading">Your study data</h2><p class="section-context">Private &amp; portable</p></div></div><DataManager client:load /></section>
</AppLayout>
