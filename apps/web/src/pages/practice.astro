---
import AppLayout from '../layouts/AppLayout.astro';
import MixedPracticeRunner from '../components/practice/MixedPracticeRunner';
---
<AppLayout title="Practice Center">
  <section class="page-width page-intro">
    <h1 class="display-title">Mix the skills, then repair the weak link.</h1>
    <p class="page-context">Cross-domain practice · locally saved evidence</p>
    <p class="lede">Original retrieval practice across the five AMAT 19 modules.</p>
    <details class="route-note">
      <summary>Content boundary</summary>
      <p>Items are generated for study and do not reproduce instructor assessments.</p>
    </details>
  </section>
  <section class="page-width module-section">
    <MixedPracticeRunner client:load mode="practice" questionCount={10} />
  </section>
</AppLayout>
