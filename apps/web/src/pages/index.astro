---
import { currentCourseProfile, liveLabs } from '@amat19/course-content';
import AppLayout from '../layouts/AppLayout.astro';
import ModuleSpotlightGrid from '../components/home/ModuleSpotlightGrid';

const moduleCount = currentCourseProfile.modules.length;
const implementedSkillCount = currentCourseProfile.skills.filter((skill) => skill.status === 'implemented').length;
---
<AppLayout title="Home">
  <section class="page-width home-hero" aria-labelledby="home-title">
    <div class="home-hero__ambient" aria-hidden="true"></div>
    <div class="home-hero__copy">
      <h1 id="home-title">Make the next step visible.</h1>
      <p class="home-hero__context">AMAT 19 · Finite mathematics workspace</p>
      <p>Study the object, change one thing, and keep the reasoning close to the result.</p>
      <div class="home-hero__actions"><a class="primary-button" href="/study">Open study queue <span aria-hidden="true">→</span></a><a class="secondary-button" href="/course">View course map</a></div>
    </div>
    <div class="home-hero__rail" aria-label="Study lab principles"><span>Local-first</span><span>Exact arithmetic</span><span>Original practice</span></div>
  </section>

  <section class="page-width home-bento" aria-labelledby="home-summary-heading">
    <article class="bento bento-briefing">
      <h2 id="home-summary-heading">Five connected modules, one visible study loop.</h2>
      <p class="bento-context">Course system summary · Grounded</p>
      <p>The current course map keeps scope, prerequisites, live labs, and supplemental depth in view so you can choose the next useful object instead of guessing where to begin.</p>
      <div class="bento-footer"><span>AY 2025–2026 · current guide first</span><a href="/study">Start with the queue <span aria-hidden="true">→</span></a></div>
    </article>

    <aside class="bento bento-attention" aria-labelledby="snapshot-title">
      <div class="home-study-snapshot" data-testid="home-study-snapshot">
        <div class="home-study-snapshot__head"><div><h2 id="snapshot-title">Study snapshot</h2><p class="home-study-snapshot__context">Math object in focus · Logic · explore</p></div><span class="status-pill">P → Q</span></div>
        <div class="home-study-snapshot__formula" aria-label="The proposition P implies Q">P → Q</div>
        <div class="home-study-snapshot__table" role="img" aria-label="Truth table preview for P implies Q">
          <span>P</span><span>Q</span><span>P → Q</span>
          <strong>T</strong><strong>T</strong><strong class="is-true">T</strong>
          <strong>T</strong><strong>F</strong><strong class="is-false">F</strong>
          <strong>F</strong><strong>T</strong><strong class="is-true">T</strong>
          <strong>F</strong><strong>F</strong><strong class="is-true">T</strong>
        </div>
        <div class="home-study-snapshot__note"><span>Next move</span><strong>Find the one false row before memorizing the definition.</strong></div>
      </div>
    </aside>

    <article class="bento metric-card"><span class="metric-card__label">Course modules</span><strong>{moduleCount}</strong><span>current map sections</span></article>
    <article class="bento metric-card"><span class="metric-card__label">Live labs</span><strong>{liveLabs.length}</strong><span>interactive tools</span></article>
    <article class="bento metric-card"><span class="metric-card__label">Core skills</span><strong>{implementedSkillCount}</strong><span>evidence-aware targets</span></article>

    <article class="bento home-route-card">
      <div><h3>Study in the order that helps.</h3><p class="route-context">Choose a route.</p></div>
      <div class="home-route-card__links"><a href="/practice"><span>Practice</span><small>Retrieve across modules</small><span aria-hidden="true">↗</span></a><a href="/progress"><span>Repair</span><small>Return to the exact weak link</small><span aria-hidden="true">↗</span></a></div>
    </article>
  </section>

  <section class="page-width section-shell home-modules" aria-labelledby="modules-heading"><div class="section-heading"><div><h2 id="modules-heading">Choose a doorway.</h2><p class="section-context">Course map</p></div><a class="text-link" href="/course">Open roadmap <span aria-hidden="true">→</span></a></div><ModuleSpotlightGrid client:visible /></section>
  <section class="page-width section-shell home-loop" aria-labelledby="loop-heading"><div class="section-heading"><div><h2 id="loop-heading">Pick up where you are.</h2><p class="section-context">Three moves</p></div><p class="section-heading__note">Short path, visible reasoning.</p></div><div class="home-loop__grid"><a class="home-loop__item" href="/study"><span class="home-loop__number">01</span><span><strong>Study</strong><small>Take the next useful skill.</small></span><span aria-hidden="true">→</span></a><a class="home-loop__item" href="/practice"><span class="home-loop__number">02</span><span><strong>Practice</strong><small>Retrieve it without the long list.</small></span><span aria-hidden="true">→</span></a><a class="home-loop__item" href="/progress"><span class="home-loop__number">03</span><span><strong>Repair</strong><small>Return to the exact weak link.</small></span><span aria-hidden="true">→</span></a></div></section>
  <section class="page-width principle-strip" aria-labelledby="principles-heading"><div class="principle-strip__heading"><h2 id="principles-heading">An instrument, not a calculator skin.</h2><p class="section-context">Built for the work</p></div><div class="principle-strip__items"><div><strong>Deterministic</strong><span>Every result exposes its structure.</span></div><div><strong>Local-first</strong><span>Your study evidence stays in this browser.</span></div><div><strong>Course-aware</strong><span>Core and supplemental topics stay distinct.</span></div></div></section>
</AppLayout>
