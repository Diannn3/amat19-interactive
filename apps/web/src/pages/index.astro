---
import { currentCourseProfile, liveLabs } from '@amat19/course-content';
import AppLayout from '../layouts/AppLayout.astro';
import ModuleSpotlightGrid from '../components/home/ModuleSpotlightGrid';
import MotionHeadline from '../components/bits/MotionHeadline';

const moduleCount = currentCourseProfile.modules.length;
const implementedSkillCount = currentCourseProfile.skills.filter((skill) => skill.status === 'implemented').length;
---
<AppLayout title="Home">
  <section class="page-width home-hub" aria-labelledby="home-title">
    <div class="home-hub__copy">
      <MotionHeadline client:load id="home-title" text="Make the next step visible." />
      <p class="home-hub__lede">Find one skill, work it in a lab, then repair what needs another pass.</p>
      <div class="home-hub__actions">
        <a class="primary-button" href="/study">Continue studying <span aria-hidden="true">→</span></a>
        <a class="secondary-button" href="/course">Browse course</a>
      </div>
    </div>

    <aside class="home-hub__preview" aria-labelledby="snapshot-title">
      <div class="home-study-snapshot" data-testid="home-study-snapshot">
        <div class="home-study-snapshot__head">
          <div>
            <h2 id="snapshot-title">Study snapshot</h2>
            <p class="home-study-snapshot__context">Logic · implication</p>
          </div>
          <code class="home-hub__formula-label">P → Q</code>
        </div>
        <div class="home-study-snapshot__formula" aria-label="The proposition P implies Q">P → Q</div>
        <div class="home-study-snapshot__table" role="img" aria-label="Truth table preview for P implies Q">
          <span>P</span><span>Q</span><span>P → Q</span>
          <strong>T</strong><strong>T</strong><strong class="is-true">T</strong>
          <strong>T</strong><strong>F</strong><strong class="is-false">F</strong>
          <strong>F</strong><strong>T</strong><strong class="is-true">T</strong>
          <strong>F</strong><strong>F</strong><strong class="is-true">T</strong>
        </div>
        <p class="home-study-snapshot__note"><span>Next move</span><strong>Find the one false row.</strong></p>
      </div>
    </aside>
  </section>

  <section class="page-width home-facts" aria-label="Course at a glance">
    <div><strong>{moduleCount}</strong><span>modules</span></div>
    <div><strong>{liveLabs.length}</strong><span>live labs</span></div>
    <div><strong>{implementedSkillCount}</strong><span>core skills</span></div>
    <p>Everything stays connected to a route, a lab, or a repair link.</p>
  </section>

  <section class="page-width section-shell home-modules" aria-labelledby="modules-heading">
    <div class="section-heading">
      <div>
        <h2 id="modules-heading">Choose a module.</h2>
        <p class="section-context">Five places to start</p>
      </div>
      <a class="text-link" href="/course">Open roadmap <span aria-hidden="true">→</span></a>
    </div>
    <ModuleSpotlightGrid client:visible />
  </section>

  <section class="page-width home-shortcuts" aria-labelledby="shortcuts-heading">
    <div>
      <h2 id="shortcuts-heading">When you know what you need.</h2>
      <p>Go straight to practice, progress, or the reference sheet.</p>
    </div>
    <nav class="home-shortcuts__links" aria-label="Study shortcuts">
      <a href="/practice"><strong>Practice</strong><span>Retrieve across modules</span><span aria-hidden="true">↗</span></a>
      <a href="/progress"><strong>Progress</strong><span>Find the next repair</span><span aria-hidden="true">↗</span></a>
      <a href="/reference"><strong>Reference</strong><span>Check a formula or assumption</span><span aria-hidden="true">↗</span></a>
    </nav>
  </section>
</AppLayout>
