---
import { currentCourseProfile } from '@amat19/course-content';
import { ArrowRight } from 'lucide-react';
import AppLayout from '../layouts/AppLayout.astro';

const workbenchesById = new Map(currentCourseProfile.workbenches.map((workbench) => [workbench.id, workbench]));
---
<AppLayout title="Home">
  <section class="page-width home-hero" data-home-hero aria-labelledby="home-title">
    <div class="home-hero__copy">
      <h1 id="home-title" class="home-hero__title">Finite mathematics, made visible.</h1>
      <p class="home-hero__lede">Study AMAT 19 through exact, interactive labs for logic, probability, financial mathematics, matrices, and applied models.</p>
      <div class="home-hero__actions">
        <a class="primary-button" data-home-primary-action href="/study">Start studying <span aria-hidden="true">→</span></a>
        <a class="secondary-button" href="/course">Explore the course</a>
      </div>
    </div>

    <nav class="home-workbench-ledger" data-home-course-rail aria-labelledby="home-workbench-heading">
      <div class="home-workbench-ledger__heading">
        <h2 id="home-workbench-heading">Open a workbench.</h2>
        <p>Choose the model your problem needs, then check every step.</p>
      </div>
      <ol>
        {currentCourseProfile.modules.map((module) => {
          const workbench = workbenchesById.get(module.id)!;
          return (
            <li>
              <a class="home-workbench-link" data-home-module href={workbench.href} aria-label={`Open ${workbench.title}`}>
                <span class="home-workbench-link__index">{String(module.order).padStart(2, '0')}</span>
                <span class="home-workbench-link__content">
                  <span class="home-workbench-link__meta">
                    <span>{module.title}</span>
                    <code data-home-notation>{workbench.notation}</code>
                  </span>
                  <strong>{workbench.title}</strong>
                  <span class="home-workbench-link__description">{workbench.description}</span>
                </span>
                <span class="home-workbench-link__action" data-home-open>
                  Open <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
  </section>

  <section class="page-width home-shortcuts" aria-labelledby="shortcuts-heading">
    <div>
      <h2 id="shortcuts-heading">Continue from here.</h2>
      <p>Resume practice, inspect your progress, or check a definition.</p>
    </div>
    <nav class="home-shortcuts__links" aria-label="Study shortcuts">
      <a href="/study"><strong>Study queue</strong><span>Continue or repair the next skill</span><span class="home-shortcuts__action">Open <ArrowRight size={15} aria-hidden="true" /></span></a>
      <a href="/progress"><strong>Progress</strong><span>Find the next repair</span><span class="home-shortcuts__action">Open <ArrowRight size={15} aria-hidden="true" /></span></a>
      <a href="/reference"><strong>Reference</strong><span>Check a formula or assumption</span><span class="home-shortcuts__action">Open <ArrowRight size={15} aria-hidden="true" /></span></a>
    </nav>
  </section>
</AppLayout>
