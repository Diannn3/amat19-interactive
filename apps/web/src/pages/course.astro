---
import { currentCourseProfile } from '@amat19/course-content';
import { ArrowRight, BookOpen, GraduationCap, ClipboardCheck, BarChart3, Search, Grid3X3, Network, Infinity } from 'lucide-react';
import AppLayout from '../layouts/AppLayout.astro';

const modulesById = new Map(currentCourseProfile.modules.map((module) => [module.id, module]));

const moduleTopics: Record<string, string[]> = {
  logic: ['Propositions', 'Truth Tables', 'Logical Equivalence'],
  probability: ['Counting Models', 'Conditioning', 'Bayes Update'],
  finance: ['Interest Rates', 'Cash Timelines', 'Annuities'],
  linear: ['Row Operations', 'Matrix Inverse', 'Systems'],
  applications: ['Graphical LP', 'Simplex Pivot', 'Game Theory'],
};
---

<AppLayout title="Course map">
  <div class="course-page">
    <header class="course-hero">
      <div class="course-hero__header">
        <h1 class="course-hero__title">Explore the Workbenches.</h1>
        <p class="course-hero__lede">
          Interactive tools for logic, probability, finance, matrices, and applications. Visualize concepts, experiment freely, and build deeper intuition in finite mathematics.
        </p>

        <div class="course-filter-bar">
          <div class="course-search-input-wrap">
            <Search size={18} strokeWidth={1.8} />
            <input 
              type="text" 
              class="course-search-input" 
              placeholder="Search workbenches, notations, or skills..." 
              aria-label="Search workbenches"
            />
          </div>

          <div class="course-filter-pills" role="tablist" aria-label="Workbench filters">
            <button class="apple-filter-pill is-active" type="button">All</button>
            <button class="apple-filter-pill" type="button">Core Topics</button>
            <button class="apple-filter-pill" type="button">Applications</button>
            <button class="apple-filter-pill" type="button">Modeling</button>
            <button class="apple-filter-pill" type="button">Interactive</button>
          </div>
        </div>
      </div>

      <div class="course-hero__stats sr-only" aria-label="Course coverage metrics">
        <div class="course-stat-chip"><span class="course-stat-chip__val">05</span><span class="course-stat-chip__label">Workbenches</span></div>
        <div class="course-stat-chip"><span class="course-stat-chip__val">26</span><span class="course-stat-chip__label">Core Skills</span></div>
        <div class="course-stat-chip"><span class="course-stat-chip__val">100%</span><span class="course-stat-chip__label">Offline Ready</span></div>
      </div>
    </header>

    {/* Five Workbenches in 5-Column Optical Glass Grid */}
    <section class="course-workbenches" aria-label="Five core course workbenches">
      <ol class="workbench-grid workbench-directory" data-testid="workbench-directory">
        {currentCourseProfile.workbenches.map((workbench, index) => {
          const module = modulesById.get(workbench.id)!;
          const topics = moduleTopics[workbench.id] || [];
          return (
            <li class={`workbench-grid__item workbench-grid__item--${workbench.id}`}>
              <a class="workbench-card apple-glass-card" href={workbench.href}>
                <div>
                  <div class="workbench-card__header">
                    <div class="apple-icon-squircle" aria-hidden="true">
                      {workbench.id === 'logic' && (
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 7h4"/><path d="M4 17h4"/><path d="M8 4v16c5 0 9-3.5 9-8s-4-8-9-8z"/><path d="M17 12h3"/>
                        </svg>
                      )}
                      {workbench.id === 'probability' && (
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 20h18"/><path d="M4 20c2 0 4-1 6-7 1.5-4.5 2-8 2-8s.5 3.5 2 8c2 6 4 7 6 7"/><line x1="12" y1="5" x2="12" y2="20" stroke-dasharray="2 2"/>
                        </svg>
                      )}
                      {workbench.id === 'finance' && <BarChart3 size={20} strokeWidth={1.8} />}
                      {workbench.id === 'linear' && <Grid3X3 size={20} strokeWidth={1.8} />}
                      {workbench.id === 'applications' && <Network size={20} strokeWidth={1.8} />}
                    </div>
                    <span class="workbench-card__index" aria-hidden="true">0{index + 1}</span>
                    <span class="workbench-card__module-name sr-only">{module.title}</span>
                  </div>

                  <div class="workbench-card__body">
                    <strong class="workbench-card__title">{workbench.title}</strong>
                    <p class="workbench-card__desc">{workbench.description}</p>
                    
                    <div class="workbench-card__topics" aria-label="Topics covered">
                      {topics.map((topic) => (
                        <span class="workbench-card__topic-tag">{topic}</span>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="workbench-card__footer">
                  <span class="workbench-card__action-text">Open Workbench</span>
                  <div class="apple-action-circle" aria-hidden="true">
                    <ArrowRight size={15} strokeWidth={2.2} />
                  </div>
                </div>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    {/* Full-Width Companion Bar */}
    <div class="course-companion-bar apple-glass-card">
      <div class="course-companion-bar__copy">
        <div class="apple-icon-squircle" aria-hidden="true">
          <Infinity size={22} strokeWidth={1.8} />
        </div>
        <div class="course-companion-bar__info">
          <strong>One Connected Course</strong>
          <p>These workbenches are part of a unified learning experience. Explore freely, or follow the syllabus for guided progression.</p>
        </div>
      </div>
      <a class="apple-btn-black" href="/study">
        Start Studying <ArrowRight size={15} strokeWidth={2.2} aria-hidden="true" />
      </a>
    </div>

    {/* Utilities Companion Section */}
    <section class="course-utilities" aria-labelledby="course-utilities-heading">
      <div class="course-utilities__header">
        <h2 id="course-utilities-heading" class="course-utilities__title">Continue from here</h2>
        <p class="course-utilities__subtitle">Course-wide study, practice, and reference tools.</p>
      </div>

      <div class="utility-grid">
        <a class="utility-card apple-glass-card" href="/study">
          <div class="utility-card__icon" aria-hidden="true">
            <GraduationCap size={20} strokeWidth={1.8} />
          </div>
          <div class="utility-card__copy">
            <div class="utility-card__title-row">
              <strong>Study Queue</strong>
              <span class="utility-card__arrow" aria-hidden="true">→</span>
            </div>
            <small>Resume active modules or practice retrieval</small>
          </div>
        </a>

        <a class="utility-card apple-glass-card" href="/exam">
          <div class="utility-card__icon" aria-hidden="true">
            <ClipboardCheck size={20} strokeWidth={1.8} />
          </div>
          <div class="utility-card__copy">
            <div class="utility-card__title-row">
              <strong>Mixed Course Check</strong>
              <span class="utility-card__arrow" aria-hidden="true">→</span>
            </div>
            <small>Multi-topic diagnostic assessment with feedback</small>
          </div>
        </a>

        <a class="utility-card apple-glass-card" href="/reference">
          <div class="utility-card__icon" aria-hidden="true">
            <BookOpen size={20} strokeWidth={1.8} />
          </div>
          <div class="utility-card__copy">
            <div class="utility-card__title-row">
              <strong>Formula &amp; Notation</strong>
              <span class="utility-card__arrow" aria-hidden="true">→</span>
            </div>
            <small>Canonical symbols, rules, and workbench links</small>
          </div>
        </a>

        <a class="utility-card apple-glass-card" href="/progress">
          <div class="utility-card__icon" aria-hidden="true">
            <BarChart3 size={20} strokeWidth={1.8} />
          </div>
          <div class="utility-card__copy">
            <div class="utility-card__title-row">
              <strong>Progress &amp; Local Data</strong>
              <span class="utility-card__arrow" aria-hidden="true">→</span>
            </div>
            <small>Inspect local mastery evidence and settings</small>
          </div>
        </a>
      </div>
    </section>
  </div>

  <script>
    function initCourseSpotlight() {
      const cards = document.querySelectorAll<HTMLElement>('.apple-glass-card');
      cards.forEach((card) => {
        card.addEventListener('pointermove', (e: PointerEvent) => {
          const rect = card.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          card.style.setProperty('--mouse-x', `${x}%`);
          card.style.setProperty('--mouse-y', `${y}%`);
          card.style.setProperty('--spotlight-opacity', '1');
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--spotlight-opacity', '0');
        });
      });
    }
    initCourseSpotlight();
    document.addEventListener('astro:page-load', initCourseSpotlight);
  </script>
</AppLayout>
