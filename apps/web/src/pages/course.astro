---
import { currentCourseProfile } from '@amat19/course-content';
import AppLayout from '../layouts/AppLayout.astro';
import { learnerScopeLabel } from '../lib/learner-labels';
---

<AppLayout title="Course map">
  <section class="page-width page-intro">
    <h1 class="display-title">Five modules. One course map.</h1>
    <p class="page-context">Course syllabus scope</p>
    <p class="lede">Open a module, pick a lab, and keep the next step close.</p>
    <details class="route-note">
      <summary>How scope is labeled</summary>
      <p>The official AMAT 19 course guide is the scope authority. Older handout-only topics stay visible as supplemental instead of becoming hidden requirements.</p>
    </details>
  </section>

  <section class="page-width module-section" aria-labelledby="course-modules-heading">
    <div class="section-heading">
      <div>
        <h2 id="course-modules-heading">Open a module.</h2>
        <p class="section-context">Five connected routes</p>
      </div>
    </div>
    <div class="course-roadmap">
      {currentCourseProfile.modules.map((module, index) => (
        <article class="roadmap-module">
          <span class="roadmap-module__number" aria-hidden="true">0{index + 1}</span>
          <div>
            <h2><a href={module.href}>{module.title}</a></h2>
            <p>{module.description}</p>
            <a class="text-link" href={module.href}>Open module <span aria-hidden="true">→</span></a>
            <details class="roadmap-details">
              <summary>{currentCourseProfile.skills.filter((skill) => skill.module === module.id).length} skills</summary>
              <div class="roadmap-skills">
                {currentCourseProfile.skills.filter((skill) => skill.module === module.id).map((skill) => (
                  <a href={skill.relatedLab || module.href}>
                    <span class="status-pill">{learnerScopeLabel(skill.status)}</span>
                    {skill.title}
                  </a>
                ))}
              </div>
            </details>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="page-width module-section" aria-labelledby="course-tools-heading">
    <div class="section-heading">
      <div>
        <h2 id="course-tools-heading">Continue from here.</h2>
        <p class="section-context">Whole-course tools</p>
      </div>
    </div>
    <div class="route-grid">
      <a class="route-link" href="/study">
        <span><strong>Study queue</strong><small>Resume a module or follow the next repair.</small></span>
        <span aria-hidden="true">→</span>
      </a>
      <a class="route-link" href="/exam">
        <span><strong>Mixed Course Check</strong><small>Submit once, then review feedback.</small></span>
        <span aria-hidden="true">→</span>
      </a>
      <a class="route-link" href="/reference">
        <span><strong>Formula &amp; Notation</strong><small>Check symbols, assumptions, and live links.</small></span>
        <span aria-hidden="true">→</span>
      </a>
      <a class="route-link" href="/progress">
        <span><strong>Progress &amp; Local Data</strong><small>Review evidence and browser-local records.</small></span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="page-width feature-band course-policy">
    <div>
      <h2>Scope stays visible.</h2>
      <p class="section-context">Course policy</p>
    </div>
    <details>
      <summary>View the source boundaries</summary>
      <div class="feature-band__grid">
        <p><strong>Current core:</strong> Logic, Probability, Financial Mathematics, Matrices, Linear Programming, and Game Theory.</p>
        <p><strong>Supplemental:</strong> older-material topics such as expected value/variance, simplex, and Markov chains remain labeled.</p>
        <p><strong>Public content:</strong> examples are original. Uploaded handouts and exams guide terminology and scope; they are not republished as a question bank.</p>
      </div>
    </details>
  </section>
</AppLayout>
