---
import { currentCourseProfile } from '@amat19/course-content';
import { ArrowRight } from 'lucide-react';
import AppLayout from '../layouts/AppLayout.astro';

const modulesById = new Map(currentCourseProfile.modules.map((module) => [module.id, module]));
---

<AppLayout title="Course map">
  <section class="page-width page-intro course-intro">
    <h1 class="display-title">Five tools for the hard parts.</h1>
    <p class="lede">Choose the module you are studying. Each workbench keeps its model, calculation, and feedback in one place.</p>
  </section>

  <section class="page-width module-section" aria-labelledby="course-workbenches-heading">
    <div class="section-heading">
      <div>
        <h2 id="course-workbenches-heading">Open a workbench.</h2>
        <p class="section-context">One focused workspace for each course module.</p>
      </div>
    </div>
    <ol class="workbench-directory" data-testid="workbench-directory">
      {currentCourseProfile.workbenches.map((workbench, index) => {
        const module = modulesById.get(workbench.id)!;
        return (
          <li>
            <a href={workbench.href}>
              <span class="workbench-directory__number" aria-hidden="true">0{index + 1}</span>
              <span class="workbench-directory__copy">
                <strong>{workbench.title}</strong>
                <small>{module.title}</small>
                <span>{workbench.description}</span>
              </span>
              <span class="workbench-directory__notation">{workbench.notation}</span>
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="page-width module-section" aria-labelledby="course-tools-heading">
    <div class="section-heading">
      <div>
        <h2 id="course-tools-heading">Continue from here.</h2>
        <p class="section-context">Course-wide support.</p>
      </div>
    </div>
    <div class="route-grid">
      <a class="route-link" href="/study">
        <span><strong>Study Queue</strong><small>Resume a module or follow the next repair.</small></span>
        <span aria-hidden="true">→</span>
      </a>
      <a class="route-link" href="/exam">
        <span><strong>Mixed Course Check</strong><small>Submit once, then review feedback.</small></span>
        <span aria-hidden="true">→</span>
      </a>
      <a class="route-link" href="/reference">
        <span><strong>Formula &amp; Notation</strong><small>Check symbols, assumptions, and workbench links.</small></span>
        <span aria-hidden="true">→</span>
      </a>
      <a class="route-link" href="/progress">
        <span><strong>Progress &amp; Local Data</strong><small>Review evidence saved in this browser.</small></span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</AppLayout>
