---
import { currentCourseProfile, logicSkills } from '@amat19/course-content';
import { getCollection } from 'astro:content';
import AppLayout from '../../../layouts/AppLayout.astro';

const lessons = (await getCollection('lessons')).filter((entry) => entry.data.module === 'logic').sort((a, b) => a.data.order - b.data.order);
const labs = currentCourseProfile.labs.filter((lab) => lab.module === 'logic');
---

<AppLayout title="Logic module">
  <section class="page-width page-intro">
    <p class="eyebrow">Module 01 · Logic</p>
    <h1 class="display-title">Reason with structure.</h1>
    <p class="lede">Move from controlled language to symbols, truth values, equivalence, argument validity, and line-by-line proof.</p>
  </section>

  <section class="page-width module-section" aria-labelledby="logic-labs-heading">
    <div class="section-heading"><div><p class="eyebrow">Interactive tools</p><h2 id="logic-labs-heading">Logic labs</h2></div></div>
    <div class="route-grid">
      {labs.map((lab) => (
        <a class="route-link" href={lab.href}><span><strong>{lab.title}</strong><small>{lab.skillIds.join(' · ')}</small></span><span class="status-pill">{lab.status}</span></a>
      ))}
    </div>
  </section>

  <section class="page-width module-section" aria-labelledby="skills-heading">
    <div class="section-heading"><div><p class="eyebrow">Prerequisite map</p><h2 id="skills-heading">Skills</h2></div></div>
    <div class="skill-grid">
      {logicSkills.map((skill) => (
        <article class="skill-item">
          <span class="status-pill">{skill.status}</span>
          <h3>{skill.title}</h3>
          <p>{skill.description}</p>
          {skill.prerequisiteIds.length > 0 && <small>Builds on: {skill.prerequisiteIds.join(', ')}</small>}
        </article>
      ))}
    </div>
  </section>

  <section class="page-width module-section" aria-labelledby="logic-lessons-heading">
    <div class="section-heading"><div><p class="eyebrow">Original reference notes</p><h2 id="logic-lessons-heading">Lessons</h2></div></div>
    <ol class="lesson-list">
      {lessons.map((lesson) => <li><a href={`/lessons/${lesson.id}`}><span>{lesson.data.title}</span><span>Read →</span></a></li>)}
    </ol>
  </section>
</AppLayout>
