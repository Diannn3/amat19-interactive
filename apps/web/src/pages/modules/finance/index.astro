---
import { currentCourseProfile, financeSkills } from '@amat19/course-content';
import { getCollection } from 'astro:content';
import AppLayout from '../../../layouts/AppLayout.astro';
const lessons=(await getCollection('lessons')).filter(e=>e.data.module==='finance').sort((a,b)=>a.data.order-b.data.order);
const labs=currentCourseProfile.labs.filter(l=>l.module==='finance');
---
<AppLayout title="Finance module">
<section class="page-width page-intro"><p class="eyebrow">Module 03 · Financial Mathematics</p><h1 class="display-title">Put every cash flow on a timeline.</h1><p class="lede">Move money to one focal date, distinguish simple from compound growth, convert equivalent rates, and value annuity payment streams.</p></section>
<section class="page-width module-section"><div class="section-heading"><div><p class="eyebrow">Interactive tools</p><h2>Labs</h2></div></div><div class="route-grid">{labs.map(l=><a class="route-link" href={l.href}><span><strong>{l.title}</strong><small>{l.skillIds.join(' · ')}</small></span><span class="status-pill">{l.status}</span></a>)}</div></section>
<section class="page-width module-section"><div class="section-heading"><div><p class="eyebrow">Course skills</p><h2>Skills</h2></div></div><div class="skill-grid">{financeSkills.map(s=><article class="skill-item"><span class="status-pill">{s.status}</span><h3>{s.title}</h3><p>{s.description}</p></article>)}</div></section>
<section class="page-width module-section"><div class="section-heading"><div><p class="eyebrow">Original reference notes</p><h2>Lessons</h2></div></div><ol class="lesson-list">{lessons.map(l=><li><a href={`/lessons/${l.id}`}><span>{l.data.title}</span><span>Read →</span></a></li>)}</ol></section>
</AppLayout>