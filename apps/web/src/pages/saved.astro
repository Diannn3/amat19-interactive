---
import AppLayout from '../layouts/AppLayout.astro';import SavedLibrary from '../components/saved/SavedLibrary';
---
<AppLayout title="Saved"><section class="page-width page-intro"><h1 class="display-title">Keep the work worth returning to.</h1><p class="page-context">Local library</p><p class="lede">Keep lessons, labs, and problems close in this browser.</p><details class="route-note"><summary>Where saved items live</summary><p>Bookmarks and saved study objects stay in this browser and are included in the local-data snapshot format.</p></details></section><section class="page-width section-shell"><SavedLibrary client:load /></section></AppLayout>
