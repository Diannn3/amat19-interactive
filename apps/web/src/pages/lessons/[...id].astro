---
import { getCollection, render } from 'astro:content';
import { skillGraph } from '@amat19/course-content';
import AppLayout from '../../layouts/AppLayout.astro';
import BookmarkButton from '../../components/saved/BookmarkButton';
import { learnerModuleLabel, learnerScopeLabel } from '../../lib/learner-labels';

export async function getStaticPaths() { const lessons = await getCollection('lessons'); return lessons.map((entry) => ({ params: { id: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const all = (await getCollection('lessons')).filter((item) => item.data.module === entry.data.module).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((item) => item.id === entry.id);const previous = index > 0 ? all[index - 1] : undefined;const next = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;
const { Content } = await render(entry);const moduleHref = `/modules/${entry.data.module}`;const lessonHref=`/lessons/${entry.id}`;const mappedSkills=skillGraph.filter(skill=>skill.lessonHref===lessonHref);const primarySkill=mappedSkills[0];const practiceHref=`${moduleHref}?view=practice${primarySkill ? `&skill=${encodeURIComponent(primarySkill.id)}` : ''}`;
const noteScope = learnerScopeLabel(entry.data.status);
const noteModule = learnerModuleLabel(entry.data.module);
---
<AppLayout title={entry.data.title}><article class="lesson-page page-width"><nav class="lab-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={moduleHref}>{noteModule}</a><span aria-hidden="true">/</span><span aria-current="page">{entry.data.title}</span></nav><header class="lesson-header"><h1>{entry.data.title}</h1><p class="lesson-header__context">{noteScope} study note</p><p>{entry.data.source}</p><div class="hero-actions"><BookmarkButton id={`lesson:${entry.id}`} title={entry.data.title} href={lessonHref} module={entry.data.module} skillIds={mappedSkills.map(s=>s.id)} client:load />{primarySkill&&<a class="hero-action hero-action--primary" href={primarySkill.labHref}>Try it interactively →</a>}<a class="hero-action hero-action--secondary" href={practiceHref}>Practice this concept</a></div></header><div class="prose"><Content /></div>{mappedSkills.length>0&&<aside class="feature-band"><div><h2>What this note unlocks</h2><p class="section-context">Skill connection</p></div><div class="feature-band__grid">{mappedSkills.slice(0,3).map(skill=><p><strong>{skill.title}</strong><br/>{skill.description}</p>)}</div></aside>}<nav class="lesson-pager" aria-label="Lesson navigation">{previous ? <a href={`/lessons/${previous.id}`}>← {previous.data.title}</a> : <span></span>}{next ? <a href={`/lessons/${next.id}`}>{next.data.title} →</a> : <a href={moduleHref}>Back to module →</a>}</nav></article></AppLayout>
