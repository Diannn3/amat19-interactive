---
import { getCollection, render } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const all = (await getCollection('lessons'))
  .filter((item) => item.data.module === entry.data.module)
  .sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((item) => item.id === entry.id);
const previous = index > 0 ? all[index - 1] : undefined;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;
const { Content } = await render(entry);
const moduleHref = `/modules/${entry.data.module}`;
---

<AppLayout title={entry.data.title}>
  <article class="lesson-page page-width">
    <nav class="lab-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href={moduleHref}>{entry.data.module}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{entry.data.title}</span>
    </nav>
    <header class="lesson-header">
      <p class="eyebrow">Original study note · {entry.data.status}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.source}</p>
    </header>
    <div class="prose"><Content /></div>
    <nav class="lesson-pager" aria-label="Lesson navigation">
      {previous ? <a href={`/lessons/${previous.id}`}>← {previous.data.title}</a> : <span></span>}
      {next ? <a href={`/lessons/${next.id}`}>{next.data.title} →</a> : <a href={moduleHref}>Back to module →</a>}
    </nav>
  </article>
</AppLayout>
