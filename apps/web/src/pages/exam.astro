---
import AppLayout from '../layouts/AppLayout.astro';
import MixedPracticeRunner from '../components/practice/MixedPracticeRunner';
---
<AppLayout title="Mixed Course Check">
  <section class="exam-intro page-width">
    <div>
      <h1>Mixed Course Check</h1>
      <p class="section-label">Independent study check</p>
      <p>Feedback stays hidden until you submit. This is an original self-check, not an official AMAT 19 examination.</p>
    </div>
  </section>
  <section class="page-width exam-stage">
    <MixedPracticeRunner client:load mode="exam" questionCount={12} />
  </section>
</AppLayout>
