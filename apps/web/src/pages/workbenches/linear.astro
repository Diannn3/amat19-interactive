---
import { workbenchForModule } from '@amat19/course-content';
import WorkbenchShell from '../../components/course/WorkbenchShell.astro';
import RowReductionLab from '../../components/labs/matrices/RowReductionLab';
import AppLayout from '../../layouts/AppLayout.astro';

const workbench = workbenchForModule('linear')!;
---

<AppLayout title={workbench.title} description={workbench.description}>
  <WorkbenchShell moduleId="linear">
    <RowReductionLab client:load />
  </WorkbenchShell>
</AppLayout>
