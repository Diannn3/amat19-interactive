---
import { workbenchForModule } from '@amat19/course-content';
import WorkbenchShell from '../../components/course/WorkbenchShell.astro';
import FormalProofLab from '../../components/labs/formal-proof/FormalProofLab';
import AppLayout from '../../layouts/AppLayout.astro';

const workbench = workbenchForModule('logic')!;
---

<AppLayout title={workbench.title} description={workbench.description}>
  <WorkbenchShell moduleId="logic">
    <FormalProofLab client:load />
  </WorkbenchShell>
</AppLayout>
