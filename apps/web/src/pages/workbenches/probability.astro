---
import { workbenchForModule } from '@amat19/course-content';
import WorkbenchShell from '../../components/course/WorkbenchShell.astro';
import ProbabilityModelBuilder from '../../components/workbenches/ProbabilityModelBuilder';
import AppLayout from '../../layouts/AppLayout.astro';

const workbench = workbenchForModule('probability')!;
---

<AppLayout title={workbench.title} description={workbench.description}>
  <WorkbenchShell moduleId="probability">
    <ProbabilityModelBuilder client:load />
  </WorkbenchShell>
</AppLayout>
