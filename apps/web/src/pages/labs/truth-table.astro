---
import AppLayout from '../../layouts/AppLayout.astro';
import TruthTableLab from '../../components/labs/truth-table/TruthTableLab';
---

<AppLayout
  title="Truth Table Lab"
  description="Build and inspect AMAT 19 propositional-logic truth tables with deterministic course-aligned semantics."
>
  <article class="lab-route">
    <nav class="lab-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href="/modules/logic">Logic</a><span aria-hidden="true">/</span>
      <span aria-current="page">Truth Table</span>
    </nav>

    <header class="lab-route__header">
      <p class="eyebrow">Logic · Truth values and truth tables</p>
      <h1>Truth Table Lab</h1>
      <p>
        Enter a proposition using keyboard aliases or course symbols. The table is generated from a parsed proposition
        tree—not by evaluating text dynamically. Select a result cell to inspect the connective rule behind it.
      </p>
    </header>

    <TruthTableLab client:load />

    <noscript>
      <p class="no-js-reference">
        Interactive practice needs JavaScript, but the connective reference below remains available.
      </p>
    </noscript>

    <details class="no-js-reference">
      <summary>Static connective reference from the course semantics</summary>
      <div style="overflow-x:auto;">
        <table class="reference-table">
          <thead>
            <tr><th>P</th><th>Q</th><th>P ∧ Q</th><th>P ∨ Q</th><th>P → Q</th><th>P ↔ Q</th><th>∼P</th></tr>
          </thead>
          <tbody>
            <tr><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>F</td></tr>
            <tr><td>T</td><td>F</td><td>F</td><td>T</td><td>F</td><td>F</td><td>F</td></tr>
            <tr><td>F</td><td>T</td><td>F</td><td>T</td><td>T</td><td>F</td><td>T</td></tr>
            <tr><td>F</td><td>F</td><td>F</td><td>F</td><td>T</td><td>T</td><td>T</td></tr>
          </tbody>
        </table>
      </div>
    </details>
  </article>
</AppLayout>
