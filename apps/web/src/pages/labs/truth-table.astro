---
import AppLayout from '../../layouts/AppLayout.astro';
import LabShell from '../../components/course/LabShell.astro';
import TruthTableLab from '../../components/labs/truth-table/TruthTableLab';
---
<AppLayout title="Truth Table Lab" description="Enter a proposition and inspect each truth-value row.">
  <LabShell moduleId="logic" moduleLabel="Logic" scope="current" title="Truth Table Lab" description="Enter a proposition, inspect each truth-value row, and select a result to see its connective rule." lessonHref="/lessons/logic/truth-tables">
    <TruthTableLab client:load />
    <noscript>
      <p class="no-js-reference">Interactive practice needs JavaScript, but the connective reference below remains available.</p>
    </noscript>
    <details class="no-js-reference">
      <summary>Static connective reference from the course semantics</summary>
      <div style="overflow-x:auto;">
        <table class="reference-table">
          <thead><tr><th>P</th><th>Q</th><th>P ∧ Q</th><th>P ∨ Q</th><th>P → Q</th><th>P ↔ Q</th><th>∼P</th></tr></thead>
          <tbody>
            <tr><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>T</td><td>F</td></tr>
            <tr><td>T</td><td>F</td><td>F</td><td>T</td><td>F</td><td>F</td><td>F</td></tr>
            <tr><td>F</td><td>T</td><td>F</td><td>T</td><td>T</td><td>F</td><td>T</td></tr>
            <tr><td>F</td><td>F</td><td>F</td><td>F</td><td>T</td><td>T</td><td>T</td></tr>
          </tbody>
        </table>
      </div>
    </details>
  </LabShell>
</AppLayout>
