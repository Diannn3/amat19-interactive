---
import type { ModuleId } from '@amat19/course-content';

interface Props {
  moduleId: ModuleId;
  moduleLabel: string;
  title: string;
  description: string;
  scope: 'current' | 'supplemental';
  lessonHref?: string;
  referenceHref?: string;
}

const {
  moduleId,
  moduleLabel,
  title,
  description,
  scope,
  lessonHref,
  referenceHref = '/reference',
} = Astro.props;
const moduleHref = `/modules/${moduleId}`;
const practicePreset = moduleId === 'linear' ? 'matrices-drill' : `${moduleId}-drill`;
const practiceHref = `${moduleHref}?view=practice&preset=${practicePreset}`;
---
<article class="lab-route" data-lab-shell={title} data-lab-scope={scope}>
  <nav class="lab-breadcrumbs" aria-label="Breadcrumb">
    <a href={moduleHref}>← {moduleLabel}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{title}</span>
  </nav>

  <header class="lab-instrument-header">
    <div class="lab-instrument-header__copy">
      <h1>{title}</h1>
      <p class="lab-instrument-header__module">{moduleLabel}</p>
      <p>{description}</p>
      {scope === 'supplemental' && <span class="lab-scope-label">Supplemental course depth</span>}
    </div>
    <nav class="lab-instrument-actions" aria-label="Lab actions">
      {lessonHref && <a href={lessonHref}>Concept</a>}
      <a href={referenceHref}>Reference</a>
      <a href={practiceHref}>Practice</a>
    </nav>
  </header>

  <section class="lab-route__workspace" aria-label={`${title} workspace`}>
    <div class="lab-route__canvas" data-lab-frame>
      <slot />
    </div>
  </section>

  <details class="lab-about">
    <summary>About this workspace</summary>
    <div class="lab-about__body">
      <p>Change one meaningful input, inspect the mathematical object, then read the explanation beside the state that produced it.</p>
      <p>Your drafts and supported evidence stay in this browser. The workspace keeps assumptions and exact steps visible instead of hiding them behind a black-box result.</p>
    </div>
  </details>
</article>
