---
import type { ModuleId } from '@amat19/course-content';

interface Props {
  moduleId: ModuleId;
  moduleLabel: string;
  title: string;
  description: string;
  eyebrow: string;
  scope: 'current' | 'supplemental';
  lessonHref?: string;
  referenceHref?: string;
}

const {
  moduleId,
  moduleLabel,
  title,
  description,
  eyebrow,
  scope,
  lessonHref,
  referenceHref = '/reference',
} = Astro.props;
const moduleHref = `/modules/${moduleId}`;
---
<article class="lab-route" data-lab-shell={title} data-lab-scope={scope}>
  <nav class="lab-breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href={moduleHref}>{moduleLabel}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{title}</span>
  </nav>

  <header class="lab-route__header">
    <div class="lab-route__heading">
      <div class="lab-route__eyebrow">
        <p class="eyebrow">{eyebrow}</p>
        <span class="lab-route__scope">{scope === 'current' ? 'Current core' : 'Supplemental depth'}</span>
      </div>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    <nav class="lab-route__links" aria-label="Lab context">
      {lessonHref && <a href={lessonHref}>Read the concept</a>}
      <a href={referenceHref}>Reference</a>
      <a href={moduleHref}>Back to {moduleLabel}</a>
    </nav>
  </header>

  <div class="lab-route__workspace">
    <slot />
  </div>
</article>
