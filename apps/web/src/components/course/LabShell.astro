---
import type { ModuleId } from '@amat19/course-content';

interface Props {
  moduleId: ModuleId;
  moduleLabel: string;
  title: string;
  description: string;
  scope: 'current' | 'supplemental';
  lessonHref?: string;
  referenceHref?: string;
}

const {
  moduleId,
  moduleLabel,
  title,
  description,
  scope,
  lessonHref,
  referenceHref = '/reference',
} = Astro.props;
const moduleHref = `/modules/${moduleId}`;
const practicePreset = moduleId === 'linear' ? 'matrices-drill' : `${moduleId}-drill`;
const practiceHref = `${moduleHref}?view=practice&preset=${practicePreset}`;
---
<article class="lab-route" data-lab-shell={title} data-lab-scope={scope}>
  <nav class="lab-breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href={moduleHref}>{moduleLabel}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{title}</span>
  </nav>

  <header class="lab-route__header">
    <div class="lab-route__heading">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    <nav class="lab-route__links" aria-label="Lab actions">
      <a href={moduleHref}>Back to {moduleLabel}</a>
      <a href={referenceHref}>Reference</a>
    </nav>
  </header>

  <div class="lab-route__workspace lab-route__workspace-frame" data-lab-frame>
    <aside class="lab-route__context-rail" aria-label="Lab context">
      <p class="lab-rail-label">Lab context</p>
      <strong>{moduleLabel}</strong>
      <span>{scope === 'current' ? 'Core course path' : 'Optional course depth'}</span>
      <nav aria-label="Lab context links">
        {lessonHref && <a href={lessonHref}>Read the concept</a>}
        <a href={referenceHref}>Check notation</a>
        <a href={practiceHref}>Practice this module</a>
      </nav>
    </aside>

    <section class="lab-route__canvas" aria-label={`${title} workspace`}>
      <slot />
    </section>

    <aside class="lab-route__support" aria-label="Lab support">
      <h2>Need a reminder?</h2>
      <p>Change one input, inspect the result, then read the explanation beside it.</p>
      <details>
        <summary>About this workspace</summary>
        <p>Your work stays in this browser. The lab exposes its assumptions and exact steps as you explore.</p>
      </details>
    </aside>
  </div>
</article>
