---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import '../styles/global.css';
import '../styles/pass4.css';
import CommandPalette from '../components/navigation/CommandPalette';
import NavGlyph from '../components/navigation/NavGlyph.astro';
import { PanelLeftClose, Search } from 'lucide-react';

interface Props { title: string; description?: string; }
type NavItem = { href: string; label: string; mobileLabel: string; icon: string };

const { title, description = 'Interactive, course-aligned AMAT 19 finite mathematics study tools.' } = Astro.props;
const primaryNavigation: NavItem[] = [
  { href: '/study', label: 'Study', mobileLabel: 'Study', icon: 'study' },
  { href: '/course', label: 'Course', mobileLabel: 'Course', icon: 'course' },
  { href: '/practice', label: 'Practice', mobileLabel: 'Practice', icon: 'practice' },
  { href: '/progress', label: 'Progress', mobileLabel: 'Progress', icon: 'progress' },
];
const utilityNavigation: NavItem[] = [
  { href: '/reference', label: 'Reference', mobileLabel: 'Ref', icon: 'reference' },
  { href: '/saved', label: 'Saved', mobileLabel: 'Saved', icon: 'saved' },
  { href: '/settings', label: 'Settings', mobileLabel: 'Settings', icon: 'settings' },
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/course') return currentPath === '/course' || currentPath.startsWith('/modules/') || currentPath.startsWith('/lessons/');
  if (href === '/practice') return currentPath === '/practice' || currentPath === '/exam';
  if (href === '/study') return currentPath === '/study';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
const utilityIsCurrent = utilityNavigation.some((item) => isCurrent(item.href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2e080d" />
    <meta name="color-scheme" content="light" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>{title} · AMAT 19 Study Lab</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell app-frame" data-shell data-route={currentPath}>
      <aside class="sidebar" aria-label="Primary navigation">
        <div class="brand-row">
          <a class="wordmark" href="/" aria-label="AMAT 19 Study Lab home">
            <span class="brand-route" aria-hidden="true"><span></span></span>
            <span class="brand-copy">
              <span class="wordmark__course">AMAT<span>19</span></span>
              <span class="wordmark__descriptor">STUDY LAB</span>
            </span>
          </a>
          <button class="icon-button sidebar-toggle" type="button" data-sidebar-toggle aria-controls="primary-navigation" aria-expanded="true" aria-label="Collapse navigation">
            <PanelLeftClose aria-hidden="true" size={18} strokeWidth={1.7} />
          </button>
        </div>

        <div class="sidebar-context" aria-label="Course context">
          <span class="sidebar-context__mark" aria-hidden="true">19</span>
          <span><strong>Finite Mathematics</strong><small>AY 2025–2026</small></span>
        </div>

        <nav class="nav-stack" id="primary-navigation" aria-label="Primary navigation">
          {primaryNavigation.map((item) => (
            <a class:list={['nav-link', { 'is-active': isCurrent(item.href) }]} href={item.href} title={item.label} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="nav-active-rail" aria-hidden="true"></span>
              <span class="nav-icon"><NavGlyph name={item.icon} /></span>
              <span class="nav-label">{item.label}</span>
            </a>
          ))}
          <details class="more-menu" data-more-menu open={utilityIsCurrent}>
            <summary class:list={['more-menu__summary', { 'is-active': utilityIsCurrent }]} aria-label="More destinations">
              <span class="nav-active-rail" aria-hidden="true"></span>
              <span class="nav-icon"><NavGlyph name="more" /></span>
              <span class="nav-label">More</span>
              <span class="more-menu__chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="more-menu__panel">
              {utilityNavigation.map((item) => (
                <a class:list={['utility-nav-link', { 'is-active': isCurrent(item.href) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="nav-icon"><NavGlyph name={item.icon} /></span>
                  <span class="nav-label">{item.label}</span>
                </a>
              ))}
            </div>
          </details>
        </nav>

        <div class="sidebar-footer">
          <div class="sidebar-profile" aria-label="Course storage">
            <span class="avatar" aria-hidden="true">A19</span>
            <span class="profile-copy"><strong>Local-first workspace</strong><small>Browser data only</small></span>
          </div>
        </div>
      </aside>

      <div class="workspace">
        <header class="topbar">
          <div class="topbar-leading">
            <div class="topbar-heading">
              <span class="topbar-kicker">AMAT 19</span>
              <span class="topbar-title">{title}</span>
            </div>
          </div>

          <div class="topbar-actions">
            <button class="topbar-search" type="button" data-command-button aria-haspopup="dialog" aria-label="Search AMAT 19">
              <Search aria-hidden="true" size={17} strokeWidth={1.7} />
              <span>Search study tools</span>
              <kbd>Ctrl K</kbd>
            </button>
            <span class="topbar-status">Local first</span>
          </div>
        </header>

        <div class="workspace-scroll">
          <div id="pwa-update" class="update-banner" hidden role="status" aria-live="polite">
            <span><strong>Update ready.</strong> Your current page will reload only when you choose.</span>
            <button id="pwa-update-button" type="button">Save & update</button>
            <button id="pwa-update-dismiss" type="button">Later</button>
          </div>
          <div id="network-status" class="network-status" hidden role="status" aria-live="polite">Offline · using saved app resources</div>
          <main id="main-content"><slot /></main>
          <footer class="site-footer">
            <div class="site-footer__inner">
              <span>AMAT 19 Study Lab · local-first deterministic learning tools</span>
              <span><a href="/settings">Settings</a> · <a href="/saved">Saved</a> · <a href="/progress">Local data</a></span>
            </div>
          </footer>
        </div>
      </div>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        {primaryNavigation.map((item) => (
          <a class:list={['mobile-nav-link', { 'is-active': isCurrent(item.href) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span class="nav-icon"><NavGlyph name={item.icon} /></span>
            <span>{item.mobileLabel}</span>
          </a>
        ))}
        <details class="mobile-more-menu" data-more-menu open={utilityIsCurrent}>
          <summary class:list={['mobile-nav-link', { 'is-active': utilityIsCurrent }]} aria-label="More destinations">
            <span class="nav-icon"><NavGlyph name="more" /></span>
            <span>More</span>
          </summary>
          <div class="mobile-more-menu__panel">
            {utilityNavigation.map((item) => (
              <a class="mobile-more-menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="nav-icon"><NavGlyph name={item.icon} /></span>
                <span>{item.label}</span>
              </a>
            ))}
          </div>
        </details>
      </nav>
    </div>

    <CommandPalette client:load />
    <script is:inline>
      (() => {
        const frame = document.querySelector('[data-shell]');
        const sidebarToggle = document.querySelector('[data-sidebar-toggle]');
        const sidebarStorageKey = 'amat19.sidebar.collapsed';
        const setCollapsed = (collapsed, persist = true) => {
          frame?.classList.toggle('nav-collapsed', collapsed);
          sidebarToggle?.setAttribute('aria-expanded', String(!collapsed));
          sidebarToggle?.setAttribute('aria-label', collapsed ? 'Expand navigation' : 'Collapse navigation');
          if (persist) {
            try { window.localStorage.setItem(sidebarStorageKey, String(collapsed)); } catch { /* storage is optional */ }
          }
        };
        try { setCollapsed(window.localStorage.getItem(sidebarStorageKey) === 'true', false); } catch { /* storage is optional */ }
        sidebarToggle?.addEventListener('click', () => setCollapsed(!frame?.classList.contains('nav-collapsed')));

        document.querySelectorAll('[data-command-button]').forEach((button) => {
          button.addEventListener('click', () => { window.dispatchEvent(new CustomEvent('amat:command')); });
        });

        const status = document.getElementById('network-status');
        const refreshNetworkStatus = () => { if (status) status.hidden = navigator.onLine; };
        window.addEventListener('online', refreshNetworkStatus); window.addEventListener('offline', refreshNetworkStatus); refreshNetworkStatus();
        if (!('serviceWorker' in navigator)) return;
        const banner = document.getElementById('pwa-update'); const updateButton = document.getElementById('pwa-update-button'); const dismissButton = document.getElementById('pwa-update-dismiss'); let waitingWorker; let reloadForUpdate = false;
        const showUpdate = (worker) => { waitingWorker = worker; if (banner) banner.hidden = false; };
        navigator.serviceWorker.register('/sw.js').then((registration) => {
          if (registration.waiting) showUpdate(registration.waiting);
          registration.addEventListener('updatefound', () => { const installing = registration.installing; if (!installing) return; installing.addEventListener('statechange', () => { if (installing.state === 'installed' && navigator.serviceWorker.controller) showUpdate(installing); }); });
        }).catch(() => {});
        updateButton?.addEventListener('click', () => { if (!waitingWorker) return; reloadForUpdate = true; window.dispatchEvent(new CustomEvent('amat:before-update')); updateButton.disabled = true; updateButton.textContent = 'Saving…'; window.setTimeout(() => waitingWorker.postMessage({ type: 'SKIP_WAITING' }), 450); });
        dismissButton?.addEventListener('click', () => { if (banner) banner.hidden = true; });
        navigator.serviceWorker.addEventListener('controllerchange', () => { if (reloadForUpdate) window.location.reload(); });
      })();
    </script>
  </body>
</html>
