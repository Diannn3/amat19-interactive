---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Interactive, course-aligned AMAT 19 finite mathematics study tools.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7b1113" />
    <meta name="color-scheme" content="light" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>{title} · AMAT 19 Study Lab</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="wordmark" href="/" aria-label="AMAT 19 Study Lab home">
            <span class="wordmark__course">AMAT 19</span>
            <span class="wordmark__descriptor">STUDY LAB</span>
          </a>
          <nav class="site-nav" aria-label="Primary navigation">
            <a href="/course">Course</a>
            <a href="/modules/logic">Logic</a>
            <a href="/modules/probability">Probability</a>
            <a href="/modules/finance">Finance</a>
            <a href="/modules/linear">Matrices</a>
            <a href="/modules/applications">Applications</a>
            <a href="/practice">Practice</a>
            <a href="/exam">Mixed Check</a>
            <a href="/progress">Progress</a>
          </nav>
        </div>
      </header>
      <div id="pwa-update" class="update-banner" hidden role="status" aria-live="polite">
        <span><strong>Update ready.</strong> Your current page will reload only when you choose.</span>
        <button id="pwa-update-button" type="button">Save & update</button>
        <button id="pwa-update-dismiss" type="button">Later</button>
      </div>
      <div id="network-status" class="network-status" hidden role="status" aria-live="polite">Offline · using saved app resources</div>
      <main id="main-content">
        <slot />
      </main>
    </div>
    <script is:inline>
      (() => {
        const status = document.getElementById('network-status');
        const refreshNetworkStatus = () => {
          if (!status) return;
          status.hidden = navigator.onLine;
        };
        window.addEventListener('online', refreshNetworkStatus);
        window.addEventListener('offline', refreshNetworkStatus);
        refreshNetworkStatus();

        if (!('serviceWorker' in navigator)) return;
        const banner = document.getElementById('pwa-update');
        const updateButton = document.getElementById('pwa-update-button');
        const dismissButton = document.getElementById('pwa-update-dismiss');
        let waitingWorker;
        let reloadForUpdate = false;

        const showUpdate = (worker) => {
          waitingWorker = worker;
          if (banner) banner.hidden = false;
        };

        navigator.serviceWorker.register('/sw.js').then((registration) => {
          if (registration.waiting) showUpdate(registration.waiting);
          registration.addEventListener('updatefound', () => {
            const installing = registration.installing;
            if (!installing) return;
            installing.addEventListener('statechange', () => {
              if (installing.state === 'installed' && navigator.serviceWorker.controller) showUpdate(installing);
            });
          });
        }).catch(() => {
          // Offline enhancement failure never blocks deterministic study tools.
        });

        updateButton?.addEventListener('click', () => {
          if (!waitingWorker) return;
          reloadForUpdate = true;
          window.dispatchEvent(new CustomEvent('amat:before-update'));
          updateButton.disabled = true;
          updateButton.textContent = 'Saving…';
          window.setTimeout(() => waitingWorker.postMessage({ type: 'SKIP_WAITING' }), 450);
        });
        dismissButton?.addEventListener('click', () => {
          if (banner) banner.hidden = true;
        });
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (reloadForUpdate) window.location.reload();
        });
      })();
    </script>
  </body>
</html>
