---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/pass4.css';
import '../styles/audit-v13.css';
import CommandPalette from '../components/navigation/CommandPalette';
import DeveloperContact from '../components/navigation/DeveloperContact.astro';
import NavGlyph from '../components/navigation/NavGlyph.astro';
import { PanelLeftClose, Search } from 'lucide-react';

interface Props { title: string; description?: string; }
type NavItem = { href: string; label: string; mobileLabel: string; icon: string; desktopOnly?: boolean };
type UtilityLink = NavItem & { kind: 'link' };
type UtilityAction = { kind: 'action'; id: 'developer-contact'; label: string; mobileLabel: string; icon: string };
type UtilityItem = UtilityLink | UtilityAction;

const { title, description = 'Interactive, course-aligned AMAT 19 finite mathematics study tools.' } = Astro.props;
const primaryNavigation: NavItem[] = [
  { href: '/', label: 'Home', mobileLabel: 'Home', icon: 'home', desktopOnly: true },
  { href: '/study', label: 'Study', mobileLabel: 'Study', icon: 'study' },
  { href: '/course', label: 'Course', mobileLabel: 'Course', icon: 'course' },
  { href: '/progress', label: 'Progress', mobileLabel: 'Progress', icon: 'progress' },
];
const utilityNavigation: UtilityItem[] = [
  { kind: 'link', href: '/reference', label: 'Reference', mobileLabel: 'Ref', icon: 'reference' },
  { kind: 'link', href: '/saved', label: 'Saved', mobileLabel: 'Saved', icon: 'saved' },
  { kind: 'link', href: '/settings', label: 'Settings', mobileLabel: 'Settings', icon: 'settings' },
  { kind: 'action', id: 'developer-contact', label: 'Developer', mobileLabel: 'Developer', icon: 'developer' },
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/course') return currentPath === '/course' || currentPath.startsWith('/modules/') || currentPath.startsWith('/lessons/');
  if (href === '/study') return currentPath === '/study' || currentPath === '/exam';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
const utilityIsCurrent = utilityNavigation.some((item) => item.kind === 'link' && isCurrent(item.href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2e080d" />
    <meta name="color-scheme" content="light" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        if (window.localStorage.getItem('amat19-motion') === 'reduced') document.documentElement.dataset.motion = 'reduced';
      } catch {}
    </script>
    <title>{title} Â· AMAT 19 Study Lab</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell app-frame" data-shell data-route={currentPath}>
      <aside class="sidebar" aria-label="Primary navigation">
        <div class="brand-row">
          <a class="wordmark" href="/" aria-label="AMAT 19 Study Lab home">
            <span class="brand-copy">
              <span class="wordmark__course">AMAT<span>19</span></span>
              <span class="wordmark__descriptor">STUDY LAB</span>
            </span>
          </a>
          <button class="icon-button sidebar-toggle" type="button" data-sidebar-toggle aria-controls="primary-navigation" aria-expanded="true" aria-label="Collapse navigation">
            <PanelLeftClose aria-hidden="true" size={18} strokeWidth={1.7} />
          </button>
        </div>

        <nav class="nav-stack" id="primary-navigation" aria-label="Primary navigation">
          {primaryNavigation.map((item) => (
            <a class:list={['nav-link', { 'is-active': isCurrent(item.href) }]} href={item.href} title={item.label} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="nav-active-rail" aria-hidden="true"></span>
              <span class="nav-icon"><NavGlyph name={item.icon} /></span>
              <span class="nav-label">{item.label}</span>
            </a>
          ))}
          <details class="more-menu more-menu--inline" data-more-menu>
            <summary class:list={['more-menu__summary', { 'is-active': utilityIsCurrent }]} aria-label="More destinations">
              <span class="nav-active-rail" aria-hidden="true"></span>
              <span class="nav-icon"><NavGlyph name="more" /></span>
              <span class="nav-label">More</span>
              <span class="more-menu__chevron" aria-hidden="true">âŒ„</span>
            </summary>
            <div class="more-menu__panel">
              {utilityNavigation.map((item) => item.kind === 'link' ? (
                <a class:list={['utility-nav-link', { 'is-active': isCurrent(item.href) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="nav-icon"><NavGlyph name={item.icon} /></span>
                  <span class="nav-label">{item.label}</span>
                </a>
              ) : (
                <button class="utility-nav-action" type="button" data-developer-contact-trigger aria-haspopup="dialog" aria-controls="developer-contact-dialog" aria-label="Developer contact">
                  <span class="nav-icon"><NavGlyph name={item.icon} /></span>
                  <span class="nav-label">{item.label}</span>
                </button>
                ))}
            </div>
          </details>
          <button
            id="desktop-more-flyout-trigger"
            class:list={['more-flyout-trigger', { 'is-active': utilityIsCurrent }]}
            type="button"
            data-more-flyout-trigger
            aria-controls="desktop-more-flyout"
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="More destinations"
          >
            <span class="nav-active-rail" aria-hidden="true"></span>
            <span class="nav-icon"><NavGlyph name="more" /></span>
            <span class="nav-label">More</span>
          </button>
        </nav>
      </aside>

      <div id="desktop-more-flyout" class="more-flyout" popover="auto" data-more-flyout>
        <nav aria-label="More destinations">
          {utilityNavigation.map((item) => item.kind === 'link' ? (
            <a class:list={['utility-flyout__link', { 'is-active': isCurrent(item.href) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="nav-icon"><NavGlyph name={item.icon} /></span>
              <span class="nav-label">{item.label}</span>
            </a>
          ) : (
            <button class="utility-flyout__action" type="button" data-developer-contact-trigger data-developer-contact-return="desktop-more-flyout-trigger" aria-haspopup="dialog" aria-controls="developer-contact-dialog" aria-label="Developer contact">
              <span class="nav-icon"><NavGlyph name={item.icon} /></span>
              <span class="nav-label">{item.label}</span>
            </button>
          ))}
        </nav>
      </div>

      <div class="workspace">
        <header class="topbar">
          <div class="topbar-leading">
            <div class="topbar-heading">
              <a class="topbar-home topbar-home-label" href="/" aria-current={currentPath === '/' ? 'page' : undefined} aria-label="AMAT 19 Study Lab home">AMAT 19</a>
              <span class="topbar-title">{title}</span>
            </div>
          </div>

          <div class="topbar-actions">
            <button class="topbar-search" type="button" data-command-button aria-haspopup="dialog" aria-label="Search AMAT 19">
              <Search aria-hidden="true" size={17} strokeWidth={1.7} />
              <span>Search study tools</span>
              <kbd>Ctrl K</kbd>
            </button>
            <span class="topbar-status">Local first</span>
          </div>
        </header>

        <div class="workspace-scroll">
          <div id="pwa-update" class="update-banner" hidden role="status" aria-live="polite">
            <span id="pwa-update-message"><strong>Update ready.</strong> Your current page will reload only when you choose.</span>
            <button id="pwa-update-button" type="button">Save & update</button>
            <button id="pwa-update-dismiss" type="button">Later</button>
          </div>
          <div id="network-status" class="network-status" hidden role="status" aria-live="polite">Offline Â· using saved app resources</div>
          <main id="main-content"><slot /></main>
          <footer class="site-footer">
            <div class="site-footer__inner">
              <span>AMAT 19 Study Lab Â· local-first learning tools</span>
              <span><a href="/settings">Settings</a> Â· <a href="/saved">Saved</a> Â· <a href="/progress">Local data</a></span>
            </div>
          </footer>
        </div>
      </div>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        {primaryNavigation.filter((item) => !item.desktopOnly).map((item) => (
          <a class:list={['mobile-nav-link', { 'is-active': isCurrent(item.href) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span class="nav-icon"><NavGlyph name={item.icon} /></span>
            <span>{item.mobileLabel}</span>
          </a>
        ))}
        <details class="mobile-more-menu" data-more-menu>
          <summary class:list={['mobile-nav-link', { 'is-active': utilityIsCurrent }]} aria-label="More destinations">
            <span class="nav-icon"><NavGlyph name="more" /></span>
            <span>More</span>
          </summary>
          <div class="mobile-more-menu__panel">
            {utilityNavigation.map((item) => item.kind === 'link' ? (
              <a class="mobile-more-menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="nav-icon"><NavGlyph name={item.icon} /></span>
                <span>{item.label}</span>
              </a>
            ) : (
              <button class="mobile-more-menu__link mobile-more-menu__action" type="button" data-developer-contact-trigger aria-haspopup="dialog" aria-controls="developer-contact-dialog" aria-label="Developer contact">
                <span class="nav-icon"><NavGlyph name={item.icon} /></span>
                <span>{item.label}</span>
              </button>
            ))}
          </div>
        </details>
      </nav>
    </div>

    <CommandPalette client:load />
    <DeveloperContact />
    <script is:inline>
      (() => {
        const frame = document.querySelector('[data-shell]');
        const sidebarToggle = document.querySelector('[data-sidebar-toggle]');
        const moreFlyoutTrigger = document.querySelector('[data-more-flyout-trigger]');
        const moreFlyout = document.querySelector('[data-more-flyout]');
        const inlineMore = document.querySelector('.sidebar [data-more-menu]');
        const inlineMoreSummary = inlineMore?.querySelector('summary');
        const sidebarNav = document.querySelector('.sidebar .nav-stack');
        const sidebar = document.querySelector('.sidebar');
        const sidebarStorageKey = 'amat19.sidebar.collapsed';
        const supportsMorePopover = moreFlyout instanceof HTMLElement
          && typeof moreFlyout.showPopover === 'function'
          && typeof moreFlyout.hidePopover === 'function';
        const isMoreFlyoutOpen = () => supportsMorePopover && moreFlyout.matches(':popover-open');
        const positionMoreFlyout = () => {
          if (!supportsMorePopover || !(moreFlyoutTrigger instanceof HTMLElement) || !(moreFlyout instanceof HTMLElement)) return;
          const triggerBox = moreFlyoutTrigger.getBoundingClientRect();
          const panelBox = moreFlyout.getBoundingClientRect();
          if (panelBox.width === 0 || panelBox.height === 0) return;
          const edge = 8;
          const gap = 8;
          const railBox = sidebar?.getBoundingClientRect();
          let left = Math.max(triggerBox.right + gap, (railBox?.right ?? 0) + gap);
          if (left + panelBox.width > window.innerWidth - edge) left = triggerBox.left - panelBox.width - gap;
          left = Math.max(edge, Math.min(left, window.innerWidth - panelBox.width - edge));
          let top = triggerBox.top;
          if (top + panelBox.height > window.innerHeight - edge) top = window.innerHeight - panelBox.height - edge;
          top = Math.max(edge, Math.min(top, window.innerHeight - panelBox.height - edge));
          moreFlyout.style.left = `${Math.round(left)}px`;
          moreFlyout.style.top = `${Math.round(top)}px`;
        };
        const syncMoreFlyoutState = () => {
          if (!(moreFlyoutTrigger instanceof HTMLElement)) return;
          const open = isMoreFlyoutOpen();
          moreFlyoutTrigger.setAttribute('aria-expanded', String(open));
          if (open) requestAnimationFrame(positionMoreFlyout);
        };
        const setCollapsed = (collapsed, persist = true) => {
          frame?.classList.toggle('nav-collapsed', collapsed);
          sidebarToggle?.setAttribute('aria-expanded', String(!collapsed));
          sidebarToggle?.setAttribute('aria-label', collapsed ? 'Expand navigation' : 'Collapse navigation');
          if (collapsed) inlineMore?.removeAttribute('open');
          if (!collapsed && isMoreFlyoutOpen()) moreFlyout.hidePopover();
          if (persist) {
            try { window.localStorage.setItem(sidebarStorageKey, String(collapsed)); } catch { /* storage is optional */ }
          }
        };
        try { setCollapsed(window.localStorage.getItem(sidebarStorageKey) === 'true', false); } catch { /* storage is optional */ }
        sidebarToggle?.addEventListener('click', () => setCollapsed(!frame?.classList.contains('nav-collapsed')));

        moreFlyoutTrigger?.addEventListener('click', () => {
          if (!supportsMorePopover) {
            setCollapsed(false);
            inlineMore?.setAttribute('open', '');
            inlineMoreSummary?.focus();
            return;
          }
          if (isMoreFlyoutOpen()) {
            moreFlyout.hidePopover();
            moreFlyoutTrigger.setAttribute('aria-expanded', 'false');
          } else {
            moreFlyout.showPopover();
            moreFlyoutTrigger.setAttribute('aria-expanded', 'true');
            positionMoreFlyout();
            requestAnimationFrame(positionMoreFlyout);
          }
        });
        moreFlyout?.addEventListener('toggle', () => {
          syncMoreFlyoutState();
          if (!isMoreFlyoutOpen() && moreFlyout instanceof HTMLElement) {
            const handoff = moreFlyout.dataset.dialogHandoff === 'true';
            moreFlyout.removeAttribute('data-dialog-handoff');
            if (!handoff && moreFlyoutTrigger instanceof HTMLElement) moreFlyoutTrigger.focus();
          }
        });
        const repositionMoreFlyout = () => positionMoreFlyout();
        window.addEventListener('resize', repositionMoreFlyout);
        sidebarNav?.addEventListener('scroll', repositionMoreFlyout, { passive: true });
        document.querySelector('.sidebar')?.addEventListener('scroll', repositionMoreFlyout, { passive: true });

        document.querySelectorAll('[data-command-button]').forEach((button) => {
          button.addEventListener('click', () => { window.dispatchEvent(new CustomEvent('amat:command', { detail: { trigger: button } })); });
        });

        const status = document.getElementById('network-status');
        const refreshNetworkStatus = () => { if (status) status.hidden = navigator.onLine; };
        window.addEventListener('online', refreshNetworkStatus); window.addEventListener('offline', refreshNetworkStatus); refreshNetworkStatus();
        if (!('serviceWorker' in navigator)) return;
        const banner = document.getElementById('pwa-update'); const updateMessage = document.getElementById('pwa-update-message'); const updateButton = document.getElementById('pwa-update-button'); const dismissButton = document.getElementById('pwa-update-dismiss'); let waitingWorker; let reloadForUpdate = false; let updateInFlight = false;
        const showUpdate = (worker) => { waitingWorker = worker; updateInFlight = false; if (updateButton) { updateButton.disabled = false; updateButton.textContent = 'Save & update'; } if (banner) banner.hidden = false; };
        navigator.serviceWorker.register('/sw.js').then((registration) => {
          if (registration.waiting) showUpdate(registration.waiting);
          registration.addEventListener('updatefound', () => { const installing = registration.installing; if (!installing) return; installing.addEventListener('statechange', () => { if (installing.state === 'installed' && navigator.serviceWorker.controller) showUpdate(installing); }); });
        }).catch(() => {});
        updateButton?.addEventListener('click', async () => {
          if (!waitingWorker || updateInFlight) return;
          updateInFlight = true;
          reloadForUpdate = false;
          updateButton.disabled = true;
          updateButton.textContent = 'Savingâ€¦';
          const tasks = [];
          window.dispatchEvent(new CustomEvent('amat:before-update', { detail: { tasks } }));
          const results = await Promise.allSettled(tasks.map((task) => Promise.resolve().then(task)));
          const failed = results.some((result) => result.status === 'rejected' || (result.status === 'fulfilled' && result.value === false));
          if (failed) {
            updateInFlight = false;
            updateButton.disabled = false;
            updateButton.textContent = 'Save & update';
            if (updateMessage) updateMessage.textContent = 'Couldnâ€™t save local work. Keep this tab open and try again.';
            return;
          }
          reloadForUpdate = true;
          waitingWorker.postMessage({ type: 'SKIP_WAITING' });
        });
        dismissButton?.addEventListener('click', () => { if (banner) banner.hidden = true; });
        navigator.serviceWorker.addEventListener('controllerchange', () => { if (reloadForUpdate) window.location.reload(); });
      })();
    </script>
  </body>
</html>
