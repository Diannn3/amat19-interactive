---
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/instrument.css';
import CommandPalette from '../components/navigation/CommandPalette';
import DeveloperContact from '../components/navigation/DeveloperContact.astro';
import BrandMark from '../components/brand/BrandMark.astro';
import NavGlyph from '../components/navigation/NavGlyph.astro';
import { Search } from 'lucide-react';

interface Props { title: string; description?: string; }
type NavItem = { href: string; label: string; mobileLabel: string; icon: string };

const { title, description = 'Interactive, course-aligned AMAT 19 finite mathematics study tools.' } = Astro.props;
const primaryNavigation: NavItem[] = [
  { href: '/', label: 'Home', mobileLabel: 'Home', icon: 'home' },
  { href: '/study', label: 'Study', mobileLabel: 'Study', icon: 'study' },
  { href: '/course', label: 'Course', mobileLabel: 'Course', icon: 'course' },
  { href: '/progress', label: 'Progress', mobileLabel: 'Progress', icon: 'progress' },
];
const utilityNavigation: NavItem[] = [
  { href: '/reference', label: 'Reference', mobileLabel: 'Reference', icon: 'reference' },
  { href: '/saved', label: 'Saved', mobileLabel: 'Saved', icon: 'saved' },
  { href: '/settings', label: 'Settings', mobileLabel: 'Settings', icon: 'settings' },
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href === '/course') return currentPath === '/course' || currentPath.startsWith('/modules/') || currentPath.startsWith('/lessons/') || currentPath.startsWith('/labs/');
  if (href === '/study') return currentPath === '/study' || currentPath === '/practice' || currentPath === '/exam';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
const utilityIsCurrent = utilityNavigation.some((item) => isCurrent(item.href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f5" />
    <meta name="color-scheme" content="light" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        if (window.localStorage.getItem('amat19-motion') === 'reduced') document.documentElement.dataset.motion = 'reduced';
      } catch {}
    </script>
    <title>{title} · AMAT 19 Study Lab</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class:list={["site-shell", "app-frame", { "exam-frame": currentPath === "/exam" }]} data-shell data-route={currentPath}>
      <aside class="sidebar" aria-label="Primary navigation">
        <div class="brand-row">
          <a class="wordmark" href="/" aria-label="AMAT 19 Study Lab home">
            <BrandMark className="wordmark__mark" variant="mono" decorative />
          </a>
        </div>

        <nav class="nav-stack" aria-label="Primary navigation">
          {primaryNavigation.map((item) => (
            <a class:list={['nav-link', { 'is-active': isCurrent(item.href) }]} href={item.href} title={item.label} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="nav-icon"><NavGlyph name={item.icon} /></span>
              <span class="nav-label">{item.label}</span>
            </a>
          ))}
        </nav>

        <nav class="nav-stack sidebar-utilities" aria-label="Utilities">
          <button class="utility-nav-action" type="button" data-command-button aria-haspopup="dialog" aria-label="Search AMAT 19">
            <span class="nav-icon"><Search aria-hidden="true" size={19} strokeWidth={1.7} /></span>
            <span class="nav-label">Search</span>
          </button>
          {utilityNavigation.map((item) => (
            <a class:list={['utility-nav-link', { 'is-active': isCurrent(item.href) }]} href={item.href} title={item.label} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="nav-icon"><NavGlyph name={item.icon} /></span>
              <span class="nav-label">{item.label}</span>
            </a>
          ))}
          <button class="utility-nav-action" type="button" data-developer-contact-trigger aria-haspopup="dialog" aria-controls="developer-contact-dialog" aria-label="Developer contact">
            <span class="nav-icon"><NavGlyph name="developer" /></span>
            <span class="nav-label">Developer</span>
          </button>
        </nav>
      </aside>

      <div class="workspace">
        <header class="topbar">
          <div class="topbar-leading">
            <div class="topbar-heading">
              <a class="topbar-home" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>AMAT 19</a>
              <span class="topbar-title">{title}</span>
            </div>
          </div>
          <div class="topbar-actions">
            <button class="topbar-search" type="button" data-command-button aria-haspopup="dialog" aria-label="Search AMAT 19">
              <Search aria-hidden="true" size={17} strokeWidth={1.7} />
              <span>Search AMAT 19</span>
              <kbd>Ctrl K</kbd>
            </button>
          </div>
        </header>

        <div class="workspace-scroll">
          <div id="pwa-update" class="update-banner" hidden role="status" aria-live="polite">
            <span id="pwa-update-message"><strong>Update ready.</strong> Your current page will reload only when you choose.</span>
            <button id="pwa-update-button" type="button">Save &amp; update</button>
            <button id="pwa-update-dismiss" type="button">Later</button>
          </div>
          <div id="network-status" class="network-status" hidden role="status" aria-live="polite">Offline · using saved app resources</div>
          <main id="main-content"><slot /></main>
          <footer class="site-footer">
            <div class="site-footer__inner">
              <span>AMAT 19 Study Lab · finite mathematics instruments</span>
              <span><a href="/reference">Reference</a> · <a href="/saved">Saved</a> · <a href="/settings">Settings</a></span>
            </div>
          </footer>
        </div>
      </div>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        {primaryNavigation.map((item) => (
          <a class:list={['mobile-nav-link', { 'is-active': isCurrent(item.href) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span class="nav-icon"><NavGlyph name={item.icon} /></span>
            <span>{item.mobileLabel}</span>
          </a>
        ))}
        <details class="mobile-more-menu">
          <summary class:list={['mobile-nav-link', { 'is-active': utilityIsCurrent }]} aria-label="More destinations">
            <span class="nav-icon"><NavGlyph name="more" /></span>
            <span>More</span>
          </summary>
          <div class="mobile-more-menu__panel">
            <button class="mobile-more-menu__link" type="button" data-command-button aria-haspopup="dialog">
              <Search aria-hidden="true" size={18} strokeWidth={1.7} /><span>Search</span>
            </button>
            {utilityNavigation.map((item) => (
              <a class="mobile-more-menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="nav-icon"><NavGlyph name={item.icon} /></span><span>{item.label}</span>
              </a>
            ))}
            <button class="mobile-more-menu__link" type="button" data-developer-contact-trigger aria-haspopup="dialog" aria-controls="developer-contact-dialog" aria-label="Developer contact">
              <NavGlyph name="developer" /><span>Developer</span>
            </button>
          </div>
        </details>
      </nav>
    </div>

    <CommandPalette client:load />
    <DeveloperContact />
    <script is:inline>
      (() => {
        document.querySelectorAll('[data-command-button]').forEach((button) => {
          button.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('amat:command', { detail: { trigger: button } }));
          });
        });

        const status = document.getElementById('network-status');
        const refreshNetworkStatus = () => { if (status) status.hidden = navigator.onLine; };
        window.addEventListener('online', refreshNetworkStatus);
        window.addEventListener('offline', refreshNetworkStatus);
        refreshNetworkStatus();

        if (!('serviceWorker' in navigator)) return;
        const banner = document.getElementById('pwa-update');
        const updateMessage = document.getElementById('pwa-update-message');
        const updateButton = document.getElementById('pwa-update-button');
        const dismissButton = document.getElementById('pwa-update-dismiss');
        let waitingWorker;
        let reloadForUpdate = false;
        let updateInFlight = false;

        const showUpdate = (worker) => {
          waitingWorker = worker;
          updateInFlight = false;
          if (updateButton) { updateButton.disabled = false; updateButton.textContent = 'Save & update'; }
          if (banner) banner.hidden = false;
        };

        navigator.serviceWorker.register('/sw.js').then((registration) => {
          if (registration.waiting) showUpdate(registration.waiting);
          registration.addEventListener('updatefound', () => {
            const installing = registration.installing;
            if (!installing) return;
            installing.addEventListener('statechange', () => {
              if (installing.state === 'installed' && navigator.serviceWorker.controller) showUpdate(installing);
            });
          });
        }).catch(() => {});

        updateButton?.addEventListener('click', async () => {
          if (!waitingWorker || updateInFlight) return;
          updateInFlight = true;
          reloadForUpdate = false;
          updateButton.disabled = true;
          updateButton.textContent = 'Saving…';
          const tasks = [];
          window.dispatchEvent(new CustomEvent('amat:before-update', { detail: { tasks } }));
          const results = await Promise.allSettled(tasks.map((task) => Promise.resolve().then(task)));
          const failed = results.some((result) => result.status === 'rejected' || (result.status === 'fulfilled' && result.value === false));
          if (failed) {
            updateInFlight = false;
            updateButton.disabled = false;
            updateButton.textContent = 'Save & update';
            if (updateMessage) updateMessage.textContent = 'Couldn’t save local work. Keep this tab open and try again.';
            return;
          }
          reloadForUpdate = true;
          waitingWorker.postMessage({ type: 'SKIP_WAITING' });
        });
        dismissButton?.addEventListener('click', () => { if (banner) banner.hidden = true; });
        navigator.serviceWorker.addEventListener('controllerchange', () => { if (reloadForUpdate) window.location.reload(); });
      })();
    </script>
  </body>
</html>
